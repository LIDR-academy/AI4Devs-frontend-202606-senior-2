**/build
**/dist

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea
.vscode

# .env

# docker compose npm cache (the dir is tracked, its contents are not)
.docker-cache/npm/*
!.docker-cache/npm/.gitkeep

# uploaded files
uploads/*
!uploads/.gitkeep
