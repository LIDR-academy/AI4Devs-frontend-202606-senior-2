# Ignore in all directories
**/.DS_Store
# Never commit real credentials; commit the .env.example templates instead.
**/.env
!**/.env.example
**/node_modules
**/prompts_master.md

# other dependencies
**/.pnp
**.pnp.js

# testing
**/coverage

# production
**/build
**/dist

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE
.idea
.vscode


# docker compose npm cache (the dir is tracked, its contents are not)
.docker-cache/npm/*
!.docker-cache/npm/.gitkeep

# uploaded files
uploads/*
!uploads/.gitkeep
