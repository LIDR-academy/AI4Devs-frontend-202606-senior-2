# Copy to `backend/.env` and fill in real values. `.env` is gitignored: never
# commit it. Only needed to run Prisma or the backend directly on the host;
# under docker compose these values come from the root .env via docker-compose.yml.
#
#   cp backend/.env.example backend/.env

DB_PASSWORD=change-me
DB_USER=LTIdbUser
DB_NAME=LTIdb
DB_PORT=5432

# Under docker compose this is overridden with the `db` service hostname.
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}"
