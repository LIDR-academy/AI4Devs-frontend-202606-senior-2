# Copy to `.env` and fill in real values. `.env` is gitignored: never commit it.
#
#   cp .env.example .env
#   sed -i "s/^DB_PASSWORD=.*/DB_PASSWORD=$(openssl rand -hex 16)/" .env
#
# docker compose reads this file for variable substitution in docker-compose.yml.

# PostgreSQL credentials. DB_PASSWORD seeds the database on first `docker compose
# up`; changing it afterwards also requires ALTER USER (or `docker compose down -v`
# to start over, which discards all data).
DB_PASSWORD=change-me
DB_USER=LTIdbUser
DB_NAME=LTIdb

# Host port PostgreSQL is published on. Inside the compose network the backend
# always reaches it at db:5432.
DB_PORT=5432

# Used when running Prisma or the backend directly on the host. Under docker
# compose this is overridden with the `db` service hostname.
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:${DB_PORT}/${DB_NAME}"

# uid:gid the backend/frontend containers run as, so files they write to the
# bind-mounted project directory stay owned by you. Set to `id -u`:`id -g`.
DOCKER_USER=1000:1000
